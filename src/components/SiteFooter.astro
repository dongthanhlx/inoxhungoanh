---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { hangMucCha } from '../data/hang-muc';

const { phapLy, boCongThuong } = site;
---

<footer class="mt-20 border-t border-[var(--color-line)] bg-[var(--color-surface-2)]">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="text-lg font-extrabold tracking-tight">INOX HÙNG OANH</p>
      <p class="mt-1 text-[15px] font-medium text-[var(--color-ink-muted)]">
        {phapLy.tenCongTy}
      </p>
      <p class="mt-4 max-w-[40ch] text-[15px] leading-relaxed text-[var(--color-ink-muted)]">
        {site.tagline}. Nhận gia công theo bản vẽ hoặc mẫu, báo giá ghi rõ mác
        inox và độ dày.
      </p>

      <address class="mt-6 grid gap-3 not-italic">
        <p class="flex items-center gap-3 text-[15px]">
          <Icon
            name="ph:phone-fill"
            class="size-5 shrink-0 text-[var(--color-ink-muted)]"
            aria-hidden="true"
          />
          <a href={site.phone.href} class="font-semibold no-underline hover:underline">
            {site.phone.display}
          </a>
        </p>
        <p class="flex items-center gap-3 text-[15px]">
          <Icon
            name="ph:chat-circle-dots-fill"
            class="size-5 shrink-0 text-[var(--color-ink-muted)]"
            aria-hidden="true"
          />
          <a href={site.zalo.href} class="font-semibold no-underline hover:underline">
            Zalo {site.zalo.display}
          </a>
        </p>
        <p class="flex items-start gap-3 text-[15px] text-[var(--color-ink-muted)]">
          <Icon
            name="ph:map-pin-fill"
            class="mt-0.5 size-5 shrink-0"
            aria-hidden="true"
          />
          <span>{site.address.full}</span>
        </p>
      </address>
    </div>

    <nav aria-labelledby="footer-san-pham">
      <p id="footer-san-pham" class="text-sm font-bold uppercase tracking-wider">
        Sản phẩm
      </p>
      <ul class="mt-4 grid gap-2.5">
        {
          hangMucCha.map((muc) => (
            <li>
              <a
                href={muc.href}
                class="text-[15px] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
              >
                {muc.ten}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-cong-ty">
      <p id="footer-cong-ty" class="text-sm font-bold uppercase tracking-wider">
        Công ty
      </p>
      <ul class="mt-4 grid gap-2.5">
        <li>
          <a
            href="/ve-chung-toi/"
            class="text-[15px] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
            >Về chúng tôi</a
          >
        </li>
        <li>
          <a
            href="/cong-trinh/"
            class="text-[15px] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
            >Công trình đã làm</a
          >
        </li>
        <li>
          <a
            href="/kien-thuc/inox-304-201-316/"
            class="text-[15px] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
            >Phân biệt inox 304, 201, 316</a
          >
        </li>
        <li>
          <a
            href="/lien-he/"
            class="text-[15px] text-[var(--color-ink-muted)] no-underline hover:text-[var(--color-ink)]"
            >Liên hệ</a
          >
        </li>
      </ul>
    </nav>
  </div>

  {/*
    Dòng pháp lý gọn. Bảng chi tiết đăng ký doanh nghiệp đã chuyển hẳn sang
    trang Về chúng tôi: ở footer nó chiếm chỗ mà không ai đọc, còn mã số thuế
    thì đủ để khách tự tra cứu nếu muốn kiểm chứng.
  */}
  <div class="border-t border-[var(--color-line)]">
    <div
      class="wrap flex flex-col gap-4 py-6 text-sm text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {new Date().getFullYear()} {phapLy.tenCongTy}
        <span class="mx-1.5 text-[var(--color-line)]">|</span>
        MST:{' '}
        <a
          href={phapLy.linkTraCuu}
          rel="nofollow noopener"
          target="_blank"
          class="font-semibold text-[var(--color-accent)] no-underline hover:underline"
        >
          {phapLy.maSoThue}
        </a>
      </p>

      {
        /*
          Logo Bộ Công Thương chỉ hiện sau khi website có bản ghi trên
          online.gov.vn (xem ghi chú trong src/data/site.ts). Khi chưa có, phát
          ra một thẻ ẩn để `npm run kiem-tra` vẫn đếm được và nhắc, thay vì việc
          này rơi vào quên lãng.
        */
        !boCongThuong.daDangKy && (
          <span hidden data-cho-noi-dung="logo-bo-cong-thuong" />
        )
      }

      {
        boCongThuong.daDangKy && boCongThuong.urlXacNhan && (
          <a
            href={boCongThuong.urlXacNhan}
            rel="nofollow noopener"
            target="_blank"
            class="inline-block shrink-0"
          >
            <img
              src="/bo-cong-thuong.png"
              alt="Đã thông báo website với Bộ Công Thương"
              width="150"
              height="57"
              loading="lazy"
            />
          </a>
        )
      }
    </div>
  </div>
</footer>
